{
  "name": "oxlint-plugin-react-hook-form",
  "version": "0.3.3",
  "description": "react-hook-form lint rules for oxlint and ESLint 9+ — a modern-API port of eslint-plugin-react-hook-form",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bevyl-ai/oxlint-plugin-react-hook-form",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bevyl-ai/oxlint-plugin-react-hook-form.git"
  },
  "bugs": {
    "url": "https://github.com/bevyl-ai/oxlint-plugin-react-hook-form/issues"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react-hook-form"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && bun test",
    "prepublishOnly": "bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.78.0"
  }
}
